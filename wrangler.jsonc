{
  "name": "crumb",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "crumb-db", "database_id": "5108c699-d6b5-41c7-8fb7-9b8f9ad14518" }
  ]
}
